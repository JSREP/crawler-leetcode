# 环境变量配置示例
# 此文件用于说明项目需要的环境变量

# 数据库配置 - Neon Serverless PostgreSQL
# 请替换为您自己的Neon数据库连接信息
DATABASE_URL="postgres://your_username:your_password@your-host.neon.tech/your_database?sslmode=require"

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED="postgresql://your_username:your_password@your-host.neon.tech/your_database?sslmode=require"

# Parameters for constructing your own connection string
PGHOST="your-host.neon.tech"
PGHOST_UNPOOLED="your-host.neon.tech"
PGUSER="your_username"
PGDATABASE="your_database"
PGPASSWORD="your_password"

# Parameters for Vercel Postgres Templates (向后兼容)
POSTGRES_URL="postgres://your_username:your_password@your-host-pooler.neon.tech/your_database?sslmode=require"
POSTGRES_URL_NON_POOLING="postgres://your_username:your_password@your-host.neon.tech/your_database?sslmode=require"
POSTGRES_USER="your_username"
POSTGRES_HOST="your-host-pooler.neon.tech"
POSTGRES_PASSWORD="your_password"
POSTGRES_DATABASE="your_database"
POSTGRES_URL_NO_SSL="postgres://your_username:your_password@your-host-pooler.neon.tech/your_database"
POSTGRES_PRISMA_URL="postgres://your_username:your_password@your-host-pooler.neon.tech/your_database?connect_timeout=15&sslmode=require"

# Stack Auth environment variables for Next.js (可选)
# 请替换为您自己的Stack Auth项目配置
NEXT_PUBLIC_STACK_PROJECT_ID="your-stack-project-id"
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY="your-stack-publishable-client-key"
STACK_SECRET_SERVER_KEY="your-stack-secret-server-key"

# Vercel Blob Store配置
BLOB_READ_WRITE_TOKEN="your_blob_read_write_token"

# 应用配置
PORT=61395
NEXT_PUBLIC_BASE_URL="http://localhost:61395"
NEXT_PUBLIC_API_URL="/api"
NEXT_PUBLIC_SITE_URL="http://localhost:61395"

# 环境配置
NODE_ENV=development