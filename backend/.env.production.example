# 生产环境配置文件示例
# 复制此文件为 .env.production 并修改相应的值

# Flask应用配置
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-production-secret-key-here-change-this

# MySQL数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=crawler_user
MYSQL_PASSWORD=your-production-db-password
MYSQL_DATABASE=crawler_leetcode

# 或者使用完整的数据库URL
# DATABASE_URL=mysql+pymysql://crawler_user:password@localhost:3306/crawler_leetcode?charset=utf8mb4

# JWT配置
JWT_SECRET_KEY=your-production-jwt-secret-key-here

# 文件存储配置
UPLOAD_FOLDER=/var/www/crawler-leetcode/storage

# GitHub OAuth配置
GITHUB_CLIENT_ID=your_production_github_client_id
GITHUB_CLIENT_SECRET=your_production_github_client_secret
GITHUB_REDIRECT_URI=https://yourdomain.com/auth/callback

# CORS配置
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# 应用配置
APP_NAME=爬虫LeetCode
APP_VERSION=2.0.0

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=/var/log/crawler-leetcode/app.log

# 缓存配置
CACHE_TYPE=redis
CACHE_REDIS_URL=redis://localhost:6379/0

# 邮件配置（可选）
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password

# 监控配置（可选）
SENTRY_DSN=your-sentry-dsn-here

# 性能配置
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_POOL_TIMEOUT=20
SQLALCHEMY_POOL_RECYCLE=3600
